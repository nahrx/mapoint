# Copy this file to .env and fill in your real values:
#   cp example.env .env
#
# .env is gitignored and dockerignored on purpose — never commit real
# credentials.

# --- ClickHouse connection (required) ---------------------------------------
HOST=127.0.0.1
PORT=9000
DATABASE=db
USERNAME=default
PASSWORD=pass

# --- Optional ----------------------------------------------------------------
# Connection protocol to ClickHouse: "native" (default, pairs with PORT=9000)
# or "http" (pairs with PORT=8123). Switch to http if your ClickHouse's
# native-port auth ever rejects credentials that work fine over HTTP.
# CH_PROTOCOL=native

# Address the web server listens on inside the container. Keep this in
# sync with the "ports:" mapping in docker-compose.yml.
HTTP_ADDR=:8082
