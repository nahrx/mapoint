# Copy this file to .env and fill in your real values:
#   cp example.env .env
#
# .env is gitignored and dockerignored on purpose — never commit real
# credentials.

# --- ClickHouse connection (required) ---------------------------------------
HOST=127.0.0.1
PORT=9000
DATABASE=db
USERNAME=default
PASSWORD=pass

# --- PostGIS connection (optional — SubSLS boundary polygons on Peta) -------
# Leave MAP_HOST empty/unset to run without this: the map still works,
# it just won't draw a SubSLS boundary polygon once filtered down to one.
# Expects a table named peta_sls_6400_rev with an idsubsls varchar column
# (same 16-digit code as ClickHouse's level_6_full_code) and a
# wkb_geometry PostGIS geometry column in SRID 4326.
MAP_DATABASE=db
MAP_HOST=localhost
MAP_PORT=5432
MAP_USERNAME=postgres
MAP_PASSWORD=asdfasdf

# --- Optional ----------------------------------------------------------------
# Connection protocol to ClickHouse: "native" (default, pairs with PORT=9000)
# or "http" (pairs with PORT=8123). Switch to http if your ClickHouse's
# native-port auth ever rejects credentials that work fine over HTTP.
# CH_PROTOCOL=native

# Address the web server listens on inside the container. Keep this in
# sync with the "ports:" mapping in docker-compose.yml.
HTTP_ADDR=:8082

# --- Login dashboard (wajib) -------------------------------------------------
# Satu akun yang boleh membuka dashboard. Server MENOLAK start kalau salah
# satu kosong — lebih baik gagal jelas daripada diam-diam tanpa login.
# Ganti password di bawah dengan yang asli di .env (jangan di file ini).
AUTH_USERNAME=viewer@bps.go.id
AUTH_PASSWORD=ganti-password-ini
